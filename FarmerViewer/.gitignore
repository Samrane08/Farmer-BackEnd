## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/

# Visual Studio Code
.vscode/

# Rider
.idea/

# EF Migrations
Migrations/

# NuGet
*.nupkg
*.snupkg
packages/
.nuget/

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log
